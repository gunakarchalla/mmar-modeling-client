{
  "name": "mmar-modeling-client-react",
  "description": "React + MUI + Zustand replica of the MMAR modeling client",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8085",
    "start": "vite --host",
    "start:prod": "vite build && vite preview --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "class-transformer": "0.5.1",
    "jwt-decode": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "reflect-metadata": "0.2.2",
    "three": "0.169.0",
    "troika-three-text": "0.47.2",
    "unzipit": "2.0.3",
    "urdf-loader": "0.13.1",
    "uuid": "14.0.2",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.169.0",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
