# Environment Variables

# API endpoint
API_URL=http://localhost:8000

# Sync server for real-time collaboration
SYNC_URL=ws://localhost:8060

# Client configuration
HTTPS=false
ANALYZE=flase
PORT=8080
COMPRESS=true
# 'all' is required to reach this dev server from another device on the LAN
ALLOWED_HOSTS=all
# overlays
ERRORS=false
WARNINGS=false
RUNTIME_ERRORS=false
# hot reload
HOT=false
LIVE_RELOAD=false
#default user credentials for client
USERNAME=admin
PASSWORD=admin
# open the bero user interface after the server starts
CI=false